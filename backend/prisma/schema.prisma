generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemMeta {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  country      String?
  city         String?
  address      String?
  postalCode   String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  otpCodeHash     String?
  otpCodeExpiresAt DateTime?
  otpCodeAttempts Int      @default(0)
  otpCodeSentAt   DateTime?
  passwordResetOtpHash String?
  passwordResetOtpExpiresAt DateTime?
  passwordResetOtpAttempts Int @default(0)
  passwordResetOtpSentAt DateTime?
  createdCars  Car[]
  reviews      Review[]
  reviewEligibilities ReviewEligibility[]
  reviewedContactMessages ContactMessage[] @relation("ContactMessageReviewer")
  jobApplications JobApplication[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Model {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  brand     String
  bodyType  String?
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, name])
}

model Car {
  id             String           @id @default(cuid())
  referenceNo    String           @unique
  title          String?
  modelId        String
  model          Model            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  year           Int
  mileage        Int?
  mileageUnit    String           @default("km")
  priceUsd       Decimal          @db.Decimal(12, 2)
  pricePkr       Decimal?         @db.Decimal(14, 2)
  fuel           FuelType?
  transmission   TransmissionType?
  seats          Int?
  color          String?
  drive          String?
  doors          Int?
  steering       SteeringType?
  engineCc       Int?
  engineCode     String?
  modelCode      String?
  chassisNo      String?          @unique
  country        String?
  city           String?
  specifications Json?
  features       Json?
  isPublished    Boolean          @default(true)
  createdByAdmin Boolean          @default(true)
  images         CarImage[]
  reviews        Review[]
  reviewEligibilities ReviewEligibility[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([modelId, year])
  @@index([isPublished])
  @@index([createdById])
  @@index([year, priceUsd])
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  key       String?
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([carId, position])
}

model ReviewEligibility {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceReference String   @unique
  carId            String?
  car              Car?     @relation(fields: [carId], references: [id], onDelete: SetNull)
  isUsed           Boolean  @default(false)
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  review           Review?

  @@index([userId, isUsed])
  @@index([carId])
}

model Review {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceReference String             @unique
  eligibilityId    String?            @unique
  eligibility      ReviewEligibility? @relation(fields: [eligibilityId], references: [id], onDelete: SetNull)
  carId            String?
  car              Car?               @relation(fields: [carId], references: [id], onDelete: SetNull)
  rating           Int
  title            String?
  comment          String
  country          String?
  isPublished      Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([isPublished, createdAt])
  @@index([rating])
  @@index([carId])
  @@index([userId, createdAt])
}

model ContactMessage {
  id                 String               @id @default(cuid())
  name               String
  email              String
  phone              String
  country            String?
  city               String?
  company            String?
  vehicleRequirement String?
  message            String
  status             ContactMessageStatus @default(NEW)
  adminNote          String?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?                @relation("ContactMessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([reviewedById])
}

model ShippingRegion {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  schedules ShippingSchedule[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([isActive, sortOrder])
  @@index([name])
}

model ShippingSchedule {
  id         String                  @id @default(cuid())
  regionId   String
  region     ShippingRegion          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  company    String
  shipName   String
  voyage     String
  sortOrder  Int                     @default(0)
  isActive   Boolean                 @default(true)
  departures ShippingDepartureEntry[]
  arrivals   ShippingArrivalEntry[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([regionId, isActive, sortOrder])
  @@index([company])
}

model ShippingDepartureEntry {
  id        String           @id @default(cuid())
  scheduleId String
  schedule  ShippingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  portName  String
  etdText   String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([scheduleId, portName])
  @@index([scheduleId, sortOrder])
}

model ShippingArrivalEntry {
  id        String           @id @default(cuid())
  scheduleId String
  schedule  ShippingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  portName  String
  etaText   String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([scheduleId, portName])
  @@index([scheduleId, sortOrder])
}

model Job {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  location    String?
  type        String?
  description String
  applyEmail  String?
  isActive    Boolean          @default(true)
  applications JobApplication[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, createdAt])
}

model JobApplication {
  id        String                @id @default(cuid())
  jobId     String
  job       Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JobApplicationStatus  @default(APPLIED)
  appliedAt DateTime              @default(now())
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([jobId, userId])
  @@index([userId, createdAt])
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  PETROL
  CNG
  LPG
  OTHER
}

enum TransmissionType {
  AT
  MT
  CVT
  OTHER
}

enum SteeringType {
  RHD
  LHD
  OTHER
}

enum UserRole {
  ADMIN
  USER
}

enum ContactMessageStatus {
  NEW
  IN_REVIEW
  RESOLVED
  SPAM
}

enum JobApplicationStatus {
  APPLIED
}
