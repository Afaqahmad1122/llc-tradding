generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemMeta {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  country      String?
  city         String?
  address      String?
  postalCode   String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  otpCodeHash     String?
  otpCodeExpiresAt DateTime?
  otpCodeAttempts Int      @default(0)
  otpCodeSentAt   DateTime?
  passwordResetOtpHash String?
  passwordResetOtpExpiresAt DateTime?
  passwordResetOtpAttempts Int @default(0)
  passwordResetOtpSentAt DateTime?
  createdCars  Car[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Model {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  brand     String
  bodyType  String?
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, name])
}

model Car {
  id             String           @id @default(cuid())
  referenceNo    String           @unique
  title          String?
  modelId        String
  model          Model            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  year           Int
  mileage        Int?
  mileageUnit    String           @default("km")
  priceGbp       Decimal          @db.Decimal(12, 2)
  pricePkr       Decimal?         @db.Decimal(14, 2)
  fuel           FuelType?
  transmission   TransmissionType?
  seats          Int?
  color          String?
  drive          String?
  doors          Int?
  steering       SteeringType?
  engineCc       Int?
  engineCode     String?
  modelCode      String?
  country        String?
  city           String?
  specifications Json?
  features       Json?
  isPublished    Boolean          @default(true)
  createdByAdmin Boolean          @default(true)
  images         CarImage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([modelId, year])
  @@index([isPublished])
  @@index([createdById])
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  key       String?
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([carId, position])
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  PETROL
  CNG
  LPG
  OTHER
}

enum TransmissionType {
  AT
  MT
  CVT
  OTHER
}

enum SteeringType {
  RHD
  LHD
  OTHER
}

enum UserRole {
  ADMIN
  USER
}
