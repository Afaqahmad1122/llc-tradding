generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemMeta {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  country      String?
  city         String?
  address      String?
  postalCode   String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  otpCodeHash     String?
  otpCodeExpiresAt DateTime?
  otpCodeAttempts Int      @default(0)
  otpCodeSentAt   DateTime?
  passwordResetOtpHash String?
  passwordResetOtpExpiresAt DateTime?
  passwordResetOtpAttempts Int @default(0)
  passwordResetOtpSentAt DateTime?
  createdCars  Car[]
  reviews      Review[]
  reviewEligibilities ReviewEligibility[]
  reviewedContactMessages ContactMessage[] @relation("ContactMessageReviewer")
  jobApplications JobApplication[]
  staffPermission StaffPermission?
  ledgerDeals LedgerDeal[] @relation("LedgerDealCustomer")
  createdLedgerDeals LedgerDeal[] @relation("LedgerDealCreator")
  receivedLedgerPayments LedgerPayment[] @relation("LedgerPaymentReceiver")
  uploadedLedgerDocuments LedgerDocument[] @relation("LedgerDocumentUploader")
  createdLedgerEvents LedgerEvent[] @relation("LedgerEventCreator")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StaffPermission {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  carsCreate    Boolean @default(false)
  carsRead      Boolean @default(false)
  carsUpdate    Boolean @default(false)
  carsDelete    Boolean @default(false)

  shippingCreate Boolean @default(false)
  shippingRead   Boolean @default(false)
  shippingUpdate Boolean @default(false)
  shippingDelete Boolean @default(false)

  reviewsCreate Boolean @default(false)
  reviewsRead   Boolean @default(false)
  reviewsUpdate Boolean @default(false)
  reviewsDelete Boolean @default(false)

  contactCreate Boolean @default(false)
  contactRead   Boolean @default(false)
  contactUpdate Boolean @default(false)
  contactDelete Boolean @default(false)

  careersCreate Boolean @default(false)
  careersRead   Boolean @default(false)
  careersUpdate Boolean @default(false)
  careersDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  brand     String
  bodyType  String?
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, name])
}

model Car {
  id             String           @id @default(cuid())
  referenceNo    String           @unique
  title          String?
  modelId        String
  model          Model            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  year           Int
  mileage        Int?
  mileageUnit    String           @default("km")
  priceUsd       Decimal?         @db.Decimal(12, 2)
  pricePkr       Decimal?         @db.Decimal(14, 2)
  priceJpy       Decimal?         @db.Decimal(14, 2)
  fuel           FuelType?
  transmission   TransmissionType?
  seats          Int?
  color          String?
  drive          String?
  doors          Int?
  steering       SteeringType?
  engineCc       Int?
  engineCode     String?
  modelCode      String?
  chassisNo      String?          @unique
  country        String?
  city           String?
  specifications Json?
  features       Json?
  isPublished    Boolean          @default(true)
  createdByAdmin Boolean          @default(true)
  images         CarImage[]
  reviews        Review[]
  reviewEligibilities ReviewEligibility[]
  events         CarEvent[]
  ledgerDeals    LedgerDeal[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([modelId, year])
  @@index([isPublished])
  @@index([createdById])
  @@index([year, priceUsd])
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  key       String?
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([carId, position])
}

model CarEvent {
  id        String        @id @default(cuid())
  carId     String
  car       Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  type      CarEventType
  createdAt DateTime      @default(now())

  @@index([carId, type, createdAt])
}

model ReviewEligibility {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceReference String   @unique
  carId            String?
  car              Car?     @relation(fields: [carId], references: [id], onDelete: SetNull)
  isUsed           Boolean  @default(false)
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  review           Review?

  @@index([userId, isUsed])
  @@index([carId])
}

model Review {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceReference String             @unique
  eligibilityId    String?            @unique
  eligibility      ReviewEligibility? @relation(fields: [eligibilityId], references: [id], onDelete: SetNull)
  carId            String?
  car              Car?               @relation(fields: [carId], references: [id], onDelete: SetNull)
  rating           Int
  title            String?
  comment          String
  country          String?
  isPublished      Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([isPublished, createdAt])
  @@index([rating])
  @@index([carId])
  @@index([userId, createdAt])
}

model ContactMessage {
  id                 String               @id @default(cuid())
  name               String
  email              String
  phone              String
  country            String?
  city               String?
  company            String?
  vehicleRequirement String?
  message            String
  status             ContactMessageStatus @default(NEW)
  adminNote          String?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?                @relation("ContactMessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([reviewedById])
}

model ShippingRegion {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  schedules ShippingSchedule[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([isActive, sortOrder])
  @@index([name])
}

model ShippingSchedule {
  id         String                  @id @default(cuid())
  regionId   String
  region     ShippingRegion          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  company    String
  shipName   String
  voyage     String
  sortOrder  Int                     @default(0)
  isActive   Boolean                 @default(true)
  departures ShippingDepartureEntry[]
  arrivals   ShippingArrivalEntry[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([regionId, isActive, sortOrder])
  @@index([company])
}

model ShippingDepartureEntry {
  id        String           @id @default(cuid())
  scheduleId String
  schedule  ShippingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  portName  String
  etdText   String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([scheduleId, portName])
  @@index([scheduleId, sortOrder])
}

model ShippingArrivalEntry {
  id        String           @id @default(cuid())
  scheduleId String
  schedule  ShippingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  portName  String
  etaText   String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([scheduleId, portName])
  @@index([scheduleId, sortOrder])
}

model Job {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  location    String?
  type        String?
  description String
  applyEmail  String?
  isActive    Boolean          @default(true)
  applications JobApplication[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, createdAt])
}

model JobApplication {
  id        String                @id @default(cuid())
  jobId     String
  job       Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JobApplicationStatus  @default(APPLIED)
  appliedAt DateTime              @default(now())
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([jobId, userId])
  @@index([userId, createdAt])
}

model LedgerDeal {
  id                  String              @id @default(cuid())
  orderNumber         String              @unique
  userId              String
  user                User                @relation("LedgerDealCustomer", fields: [userId], references: [id], onDelete: Restrict)
  carId               String
  car                 Car                 @relation(fields: [carId], references: [id], onDelete: Restrict)
  createdById         String?
  createdBy           User?               @relation("LedgerDealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  totalAmount         Decimal             @db.Decimal(14, 2)
  currency            LedgerCurrency      @default(JPY)
  downPaymentRequired Decimal?            @db.Decimal(14, 2)
  dueDate             DateTime?
  status              LedgerDealStatus    @default(PENDING_CONFIRMATION)
  note                String?
  payments            LedgerPayment[]
  documents           LedgerDocument[]
  events              LedgerEvent[]
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([carId])
  @@index([status, createdAt])
  @@index([currency])
  @@index([deletedAt])
}

model LedgerPayment {
  id           String              @id @default(cuid())
  dealId       String
  deal         LedgerDeal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount       Decimal             @db.Decimal(14, 2)
  currency     LedgerCurrency
  type         LedgerPaymentType   @default(INSTALLMENT)
  method       LedgerPaymentMethod @default(OTHER)
  paidAt       DateTime            @default(now())
  referenceNo  String?
  note         String?
  receivedById String?
  receivedBy   User?               @relation("LedgerPaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([dealId, paidAt])
  @@index([receivedById])
  @@index([type])
  @@index([deletedAt])
}

model LedgerDocument {
  id                String             @id @default(cuid())
  dealId            String
  deal              LedgerDeal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type              LedgerDocumentType @default(OTHER)
  title             String
  fileKey           String
  fileUrl           String?
  fileName          String
  mimeType          String
  fileSize          Int?
  visibleToCustomer Boolean            @default(false)
  note              String?
  uploadedById      String?
  uploadedBy        User?              @relation("LedgerDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([dealId, type])
  @@index([uploadedById])
  @@index([visibleToCustomer])
  @@index([deletedAt])
}

model LedgerEvent {
  id          String          @id @default(cuid())
  dealId      String
  deal        LedgerDeal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type        LedgerEventType
  message     String
  metadata    Json?
  createdById String?
  createdBy   User?           @relation("LedgerEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([dealId, createdAt])
  @@index([createdById])
  @@index([type])
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  PETROL
  CNG
  LPG
  OTHER
}

enum TransmissionType {
  AT
  MT
  CVT
  OTHER
}

enum SteeringType {
  RHD
  LHD
  OTHER
}

enum UserRole {
  ADMIN
  STAFF
  USER
}

enum ContactMessageStatus {
  NEW
  IN_REVIEW
  RESOLVED
  SPAM
}

enum JobApplicationStatus {
  APPLIED
}

enum CarEventType {
  DETAIL_VIEW
  WHATSAPP_CLICK
  EMAIL_CLICK
}

enum LedgerCurrency {
  JPY
  USD
  PKR
  AED
}

enum LedgerDealStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_TRANSIT
  ARRIVED
  PAYMENT_COMPLETED
  DOCUMENTS_DISPATCHED
  DELIVERED
  CANCELLED
}

enum LedgerPaymentType {
  DOWN_PAYMENT
  INSTALLMENT
  FINAL_PAYMENT
  REFUND
  ADJUSTMENT
}

enum LedgerPaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  ONLINE
  OTHER
}

enum LedgerDocumentType {
  INVOICE
  PURCHASE_RECEIPT
  INSPECTION_SHEET
  EXPORT_CERTIFICATE
  BILL_OF_LADING
  SHIPPING_INVOICE
  PAYMENT_RECEIPT
  OTHER
}

enum LedgerEventType {
  DEAL_CREATED
  DEAL_UPDATED
  PAYMENT_ADDED
  PAYMENT_DELETED
  DOCUMENT_ADDED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  NOTE_ADDED
}
