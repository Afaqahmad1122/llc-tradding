NODE_ENV=development
PORT=4000
BCRYPT_SALT_ROUNDS=12
DATABASE_URL="postgresql://apple@localhost:5432/llc_trading?schema=public"
# Comma-separated; include every browser origin that calls the API with credentials (storefront, admin app, etc.).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
JWT_ACCESS_SECRET="replace_with_64+_char_random_secret"
JWT_REFRESH_SECRET="replace_with_64+_char_random_secret"
COOKIE_SECRET="replace_with_64+_char_random_secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
