NODE_ENV=development
PORT=4000
BCRYPT_SALT_ROUNDS=12
DATABASE_URL="postgresql://apple@localhost:5432/llc_trading?schema=public"
# Comma-separated; include every browser origin that calls the API with credentials (storefront, admin app, etc.).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
JWT_ACCESS_SECRET="replace_with_64+_char_random_secret"
JWT_REFRESH_SECRET="replace_with_64+_char_random_secret"
COOKIE_SECRET="replace_with_64+_char_random_secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# --- Email (required) — used for signup / password-reset OTP via Nodemailer ---
# Production on Hostinger: create a mailbox in hPanel, then use e.g.
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465 and SMTP_SECURE=true  (implicit TLS), or
#   SMTP_PORT=587 and SMTP_SECURE=false (STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your_smtp_password"
# Displayed as From; use the same mailbox or an alias your provider allows to send as.
MAIL_FROM="Icc Trading <noreply@yourdomain.com>"

# Inbox that receives every Contact Us form submission.
CONTACT_NOTIFICATION_EMAIL="icctradingjp@gmail.com"

# Optional; defaults to icctradingjp@gmail.com. All job applications use this mailto address.
# JOB_APPLICATIONS_EMAIL="icctradingjp@gmail.com"
# Optional storefront FX: Open Exchange Rates app id (improves currency coverage vs free Frankfurter fallback).
# OPEN_EXCHANGE_RATES_APP_ID=""
